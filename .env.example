# Iris appliance configuration.
# Copy to .env and fill in values. All AI features are optional — with no key the app
# runs entirely on the deterministic prebuilt-component engine.

# OpenAI API key. When set, the workspace chat uses GPT to interpret design edits.
OPENAI_API_KEY=

# Model used for chat-driven edits (any OpenAI chat model).
OPENAI_MODEL=gpt-4o-mini

# Optional: point at an OpenAI-compatible endpoint (Azure OpenAI, local proxy, etc.).
OPENAI_BASE_URL=

# Where generated projects + site source are stored inside the container.
# In local dev, if this path isn't writable it falls back to <cwd>/data automatically.
IRIS_DATA_DIR=/data

# Secret used to sign auth session cookies (HMAC-SHA256). REQUIRED in production —
# generate a long random value, e.g. `openssl rand -hex 32`. If unset, a fixed
# dev-only fallback is used (insecure; never deploy without setting this).
IRIS_AUTH_SECRET=
